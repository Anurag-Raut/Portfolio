---
import { siteConfig } from '../data/site';

const navItems = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
  { label: 'Writing', href: '/blog/' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-canvas/90 backdrop-blur-sm">
  <div class="mx-auto flex min-h-16 max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
    <a href="/" class="font-mono text-sm font-medium tracking-tight text-text" aria-label="Anurag Raut home">
      <span>anurag</span><span class="text-accent">.raut</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-muted hover:text-accent">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
