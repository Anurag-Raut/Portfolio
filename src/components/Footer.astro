---
import { siteConfig, socialLinks } from '../data/site';
const github = socialLinks.find((link) => link.name === 'GitHub');
const linkedin = socialLinks.find((link) => link.name === 'LinkedIn');
const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-border bg-surface">
  <div class="content-wrapper">
    <h2 class="section-title">Contact</h2>
    <p class="body-text mt-4">I'm open to new opportunities and interesting projects. The fastest way to reach me is email.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`mailto:${siteConfig.email}`} class="primary-link">{siteConfig.email}</a>
      {github && <a href={github.url} target="_blank" rel="noopener noreferrer" class="secondary-link">GitHub</a>}
      {linkedin && <a href={linkedin.url} target="_blank" rel="noopener noreferrer" class="secondary-link">LinkedIn</a>}
    </div>
    <p class="metadata mt-12">© {year} {siteConfig.name}</p>
  </div>
</footer>
